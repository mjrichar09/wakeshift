{
  "name": "knuckleball-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive 3D lab for low-spin ball flight: the baseball knuckleball and the volleyball float serve.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "format": "prettier --write .",
    "csv": "tsx scripts/dump-csv.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "three": "^0.186.1",
    "tweakpane": "^4.0.5",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
